# Copy this file to .env and replace every placeholder before deployment.

DATABASE_URL=postgresql+asyncpg://ta_admin:change-me@postgres:5432/ta_platform
DB_PASSWORD=change-me
REDIS_URL=redis://redis:6379
USE_REDIS=true

JWT_SECRET=generate-a-long-random-secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

ALIBABA_SMS_ACCESS_KEY=
ALIBABA_SMS_SECRET=
ALIBABA_SMS_SIGN_NAME=
ALIBABA_SMS_TEMPLATE_CODE=
ALIBABA_NLS_APP_KEY=
ALIBABA_NLS_ACCESS_KEY_ID=
ALIBABA_NLS_ACCESS_KEY_SECRET=
ALIBABA_ASR_ENDPOINT=
ALIBABA_TTS_ENDPOINT=
ALIBABA_TTS_VOICE=siyue

CORS_ORIGINS=https://your-domain.example
ROBOT_AUTH_KEYS=TA-Robot-01:generate-a-robot-secret
SEED_DEMO_DATA=false
UPLOAD_DIR=./uploads

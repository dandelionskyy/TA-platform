# Copy to .env and set all required secrets before running Docker Compose.
# Never commit .env or include it in a handover archive.
DB_PASSWORD=
JWT_SECRET=
ROBOT_AUTH_KEYS=
CORS_ORIGINS=http://localhost
DEEPSEEK_API_KEY=

# BRIDGE model services must run on institution-approved infrastructure.
# Example URL for an Ollama-compatible server reachable from the backend container:
# BRIDGE_LLM_URL=http://model-server:11434
# BRIDGE_EMBEDDINGS_URL=http://model-server:11434/api/embed
BRIDGE_LLM_URL=
BRIDGE_LLM_MODEL=
BRIDGE_PROVIDER=ollama
BRIDGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
BRIDGE_DEEPSEEK_MODEL=deepseek-chat
BRIDGE_LLM_TIMEOUT_SECONDS=12
BRIDGE_TURN_TIMEOUT_SECONDS=35
# Optional Ollama profile resource caps for small ECS trials.
BRIDGE_OLLAMA_CPUS=2
BRIDGE_OLLAMA_MEMORY=4g
BRIDGE_EMBEDDINGS_URL=
BRIDGE_EMBEDDINGS_MODEL=bge-m3
BRIDGE_ALLOW_LEXICAL_PROTOTYPE=false
BRIDGE_MIN_SIMILARITY=0.65
BRIDGE_UPLOAD_MAX_MB=50
BRIDGE_SESSION_DAYS=30
